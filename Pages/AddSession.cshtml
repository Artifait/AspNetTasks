@page
@model AspNetTasks.Pages.AddSessionModel
@{
    ViewData["Title"] = "Добавить сеанс фильма";
}
<div class="container">
    <h1>@ViewData["Title"]</h1>
    <form method="post" class="form">
        <div class="form-group">
            <label for="FilmId">Выберите фильм:</label>
            <select id="FilmId" name="FilmId" required class="form-control">
                @foreach (var film in Model.Films)
                {
                    <option value="@film.Id">@film.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="StartTime">Время начала:</label>
            <input type="datetime-local" id="StartTime" name="StartTime" required class="form-control" />
        </div>
        <div class="form-group">
            <label for="EndTime">Время конца:</label>
            <input type="datetime-local" id="EndTime" name="EndTime" required class="form-control" />
        </div>
        <div class="form-group">
            <button type="submit" class="button">Добавить сеанс</button>
        </div>
    </form>
</div>
