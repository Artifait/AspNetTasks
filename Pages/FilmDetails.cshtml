@page "{id:int}"
@model AspNetTasks.Pages.FilmDetailsModel
@{
    ViewData["Title"] = Model.Film.Name;
}

<div class="container">
    <h1>@Model.Film.Name</h1>
    <p><strong>Режиссер:</strong> @Model.Film.FilmMaker</p>
    <p><strong>Стиль:</strong> @Model.Film.Style</p>
    <p><strong>Описание:</strong> @Model.Film.Summary</p>

    <h3>Сеансы</h3>
    @if (Model.Film.Sessions.Any())
    {
        <table class="sessions-table">
            <thead>
                <tr>
                    <th>Начало</th>
                    <th>Окончание</th>
                    <th>Заполненность</th>
                    <th>Детали</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.Film.Sessions)
                {
                    var totalSeats = session.Seats.Count();
                    var reservedSeats = Model.ReservedSeats.ContainsKey(session.Id)
                    ? Model.ReservedSeats[session.Id]
                    : 0;
                    var freeSeats = totalSeats - reservedSeats;

                    <tr>
                        <td>@session.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@session.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@reservedSeats/@totalSeats</td>
                        <td><a href="/SessionDetails/@session.Id" class="button">Просмотр</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Нет доступных сеансов.</p>
    }

    <a href="/EditFilm/@Model.Film.Id" class="button">Редактировать фильм</a>
</div>
