@page
@model AspNetTasks.Pages.FilmSearchModel
@using System.Reflection
@{
    ViewData["Title"] = "Поиск фильмов";
    // Получаем все публичные свойства фильтра
    var filterProperties = Model.Filter.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance | BindingFlags.SetProperty);
}

<div class="container">
    <h1>@ViewData["Title"]</h1>
    <!-- Форма поиска фильмов -->
    <form method="get" class="form">
        @foreach (var prop in filterProperties)
        {
            // Если свойство не может быть установлено, пропускаем его
            if (!prop.CanWrite)
            {
                continue;
            }

            var propName = prop.Name;
            var propValue = prop.GetValue(Model.Filter);
            string inputType = "text";

            var propType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

            if (propType == typeof(DateTime))
            {
                inputType = "date";
                if (propValue != null)
                {
                    propValue = ((DateTime)propValue).ToString("yyyy-MM-dd");
                }
            }
            else if (propType.Name == "DateOnly")
            {
                inputType = "date";
                if (propValue != null)
                {
                    propValue = propValue.ToString();
                }
            }
            else if (propType == typeof(int) || propType == typeof(long))
            {
                inputType = "number";
            }
            else if (propType == typeof(float) || propType == typeof(double) || propType == typeof(decimal))
            {
                inputType = "number";
            }

            <div class="form-group">
                <label for="@propName">@propName</label>
                <input type="@inputType" id="@propName" name="Filter.@propName" class="form-control" value="@(propValue ?? "")" />
            </div>
        }
        <button type="submit" class="button">Поиск</button>
    </form>

    <h2>Результаты поиска</h2>
    <div>
        @if (Model.Films.Any())
        {
            @foreach (var film in Model.Films)
            {
                <div class="movie-info">
                    <h3>@film.Name</h3>
                    <p><strong>Режиссер:</strong> @film.FilmMaker</p>
                    <p><strong>Стиль:</strong> @film.Style</p>
                    <p><strong>Описание:</strong> @film.Summary</p>

                    <h4>Сеансы:</h4>
                    @if (film.Sessions.Any())
                    {
                        <ul>
                            @foreach (var session in film.Sessions)
                            {
                                <li>
                                    <strong>Начало:</strong> @session.StartTime.ToString("dd.MM.yyyy HH:mm") <br />
                                    <strong>Окончание:</strong> @session.EndTime.ToString("dd.MM.yyyy HH:mm")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Нет доступных сеансов.</p>
                    }
                </div>
            }
        }
        else
        {
            <p>Фильмы не найдены.</p>
        }
    </div>
</div>
