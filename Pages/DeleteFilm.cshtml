@page
@model AspNetTasks.Pages.DeleteFilmModel
@{
    ViewData["Title"] = "Удалить фильм";
}
<div class="container">
    <h1>@ViewData["Title"]</h1>
    <form method="post" class="form">
        <div class="form-group">
            <label for="FilmId">Выберите фильм для удаления:</label>
            <select id="FilmId" name="FilmId" required class="form-control">
                @foreach (var film in Model.Films)
                {
                    <option value="@film.Id">@film.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <button type="submit" class="button">Удалить фильм</button>
        </div>
    </form>
</div>
