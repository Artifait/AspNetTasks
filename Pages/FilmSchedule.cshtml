@page
@model AspNetTasks.Pages.FilmScheduleModel
@{
    ViewData["Title"] = "Расписание показов";
}


<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Расписание фильмов</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        /* Основные стили */
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #121212;
            color: #fff;
            box-sizing: border-box;
        }

        header {
            background-color: #1c1c1c;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 2.5rem;
            margin: 0;
        }

        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background-color: #2a2a2a;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }

        .movie-info {
            margin-bottom: 40px;
        }

        .movie-info h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .movie-info p {
            font-size: 1rem;
            margin: 5px 0;
        }

        .sessions-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sessions-list li {
            background-color: #3a3a3a;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

        .sessions-list li:hover {
            background-color: #444;
            transform: translateY(-5px);
        }

        .sessions-list li .session-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .session-info span {
            font-size: 1rem;
            color: #bbb;
        }

        .session-info i {
            font-size: 1.2rem;
            color: #ff4081;
        }

        .movie-info .sessions-list li i {
            margin-left: 10px;
        }

        .button {
            padding: 10px 20px;
            background-color: #ff4081;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

        .button:hover {
            background-color: #ff80ab;
        }

        footer {
            background-color: #1c1c1c;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
        }

            .container {
                padding: 10px;
                margin: 10px;
            }

            .sessions-list li {
                padding: 10px;
            }

            .button {
                width: 100%;
                margin-top: 20px;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>Расписание фильмов</h1>
    </header>

    <div class="container">
        @foreach (var movie in Model.Films)
        {
            <div class="movie-info">
                <h2>@movie.Name</h2>
                <p><strong>Режиссер:</strong> @movie.FilmMaker</p>
                <p><strong>Стиль:</strong> @movie.Style</p>
                <p><strong>Краткое описание:</strong> @movie.Summary</p>

                <h3>Сеансы</h3>
                <ul class="sessions-list">
                    @foreach (var session in movie.Sessions)
                    {
                        <li>
                            <div class="session-info">
                                <div>
                                    <span>Start: @session.StartTime.ToString("dd.MM.yyyy HH:mm")</span>
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <br />
                                <div>
                                    <span>End: @session.EndTime.ToString("dd.MM.yyyy HH:mm")</span>
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <a href="/AddSession" class="button">Добавить сеанс</a>
            </div>
        }
    </div>

    <footer>
        <p>&copy; 2025 Кинотеатр</p>
    </footer>

</body>
</html>