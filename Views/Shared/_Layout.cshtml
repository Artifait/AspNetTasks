<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MyApp</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <div class="container">
            <h1>MyApp</h1>
            <div class="user-info">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>Вы вошли как: @User.Identity.Name</span>
                    <a href="@Url.Action("Logout", "Account")">Выход</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")">Вход</a>
                    <a href="@Url.Action("Register", "Account")">Регистрация</a>
                }
            </div>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer>
        <div class="container">
            <p>&copy; @DateTime.Now.Year - MyApp</p>
        </div>
    </footer>
</body>
</html>
