@model AspNetTasks.Models.Game

<h2>Add New Game</h2>

<form asp-action="AddGame" method="post">
    <label>Name</label>
    <input asp-for="Name" />

    <label>Genre</label>
    <input asp-for="Genre" />

    <label>Description</label>
    <textarea asp-for="Description"></textarea>

    <label>Price</label>
    <input asp-for="Price" />

    <button type="submit">Add Game</button>
</form>
