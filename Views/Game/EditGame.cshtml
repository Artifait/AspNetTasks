@model AspNetTasks.Models.Game

<h2>Edit Game</h2>

<form asp-action="EditGame" method="post">
    <input type="hidden" asp-for="Id" />

    <label>Name</label>
    <input asp-for="Name" />

    <label>Genre</label>
    <input asp-for="Genre" />

    <label>Description</label>
    <textarea asp-for="Description"></textarea>

    <label>Price</label>
    <input asp-for="Price" />

    <button type="submit">Save Changes</button>
</form>
